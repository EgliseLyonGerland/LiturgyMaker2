    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "isbot": "^5",
    "lucide-react": "^1.48.0",
    "radashi": "^12.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-firebase-hooks": "^5.1.1",
    "react-hook-form": "^7.88.0",
