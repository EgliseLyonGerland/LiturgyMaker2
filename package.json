{
  "name": "liturgy-maker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev-server": "firebase emulators:start --import=.firebase/export",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "preview": "vite preview",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@formisch/react": "^1.0.0",
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "isbot": "^5",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-firebase-hooks": "^5.1.1",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "lint-staged": "^17.4.1",
    "oxc-transform-react": "^0.147.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.79.0",
    "shadcn": "^4.19.1",
    "simple-git-hooks": "^2.14.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "npm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
